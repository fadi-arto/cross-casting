# =============================================================================
#  Cross-Casting Audit API — Environment Variables
#  Copy to .env and fill in secrets before running.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
MAX_PDF_PAGES=50
RENDER_DPI=150
ABS_TOLERANCE=0.01
# Allowed frontend origins for CORS (comma-separated; "*" = any)
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Use service name "postgres" in Docker; "localhost" for local dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=crosscasting
DB_USER=crosscasting
DB_PASSWORD=changeme_in_production
DB_EXPOSE_PORT=5432

# ── MinIO Object Storage (S3-compatible) ───────────────────────────────────────
# Use service name "minio" in Docker; "localhost:9000" for local dev
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_in_production
MINIO_SECURE=false
MINIO_BUCKET=crosscasting-files
MINIO_PRESIGNED_URL_EXPIRES_HOURS=24
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001       # MinIO web console → http://localhost:9001

# ── VLM — Visual Language Model (table extraction from PDFs / images) ──────────
#
#  backend options:
#    stub        — no model (safe default; returns empty tables)
#    local       — OpenAI-compatible server (Ollama, LM Studio, Gemini proxy)
#    anthropic   — Anthropic Claude API
#
VLM_BACKEND=stub
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=not-needed-locally
VLM_JSON_MODE=json_object       # json_object | json_schema | none
VLM_TIMEOUT_SECONDS=180
VLM_MAX_TOKENS=8192
VLM_TEMPERATURE=0.0

# ── Anthropic Claude ───────────────────────────────────────────────────────────
#  Used when VLM_BACKEND=anthropic. The key is read from the environment only:
#  never commit it (.env is git-ignored), never put it in frontend code.
#  Verified model IDs: claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 | claude-opus-5-5
#  Timeout and max tokens come from VLM_TIMEOUT_SECONDS / VLM_MAX_TOKENS unless the
#  ANTHROPIC_ overrides below are set. VLM_TEMPERATURE is NOT used by this backend:
#  the SDK's API version (2026-10-21) rejects sampling parameters.
#  If the call fails (bad key, model, rate limit, timeout) the job FAILS — there is
#  no silent fallback to the stub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
#  Effort: low | medium | high | xhigh | max (empty = the model's default)
ANTHROPIC_EFFORT=
ANTHROPIC_MAX_RETRIES=2
#  Optional overrides of VLM_TIMEOUT_SECONDS / VLM_MAX_TOKENS:
# ANTHROPIC_TIMEOUT_SECONDS=180
# ANTHROPIC_MAX_TOKENS=8192

# ── OCR (optional) ─────────────────────────────────────────────────────────────
# backend options: none | stub | tesseract
OCR_BACKEND=stub
OCR_LANGS=ara+eng
OCR_TIMEOUT_SECONDS=60

# ── LLM — Language Model (optional error interpretation) ──────────────────────
#  backend options: none | local
#
#  Example — Gemini Flash via OpenAI-compatible proxy:
#    LLM_BACKEND=local
#    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#    LLM_MODEL=gemini-2.0-flash-exp
#    LLM_API_KEY=<google-api-key>
LLM_BACKEND=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=not-needed-locally
LLM_JSON_MODE=json_object
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
